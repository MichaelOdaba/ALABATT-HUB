# DJANGO_SECRET_KEY=                                                        # Secret key used by Django; never commit a real value.
# DEBUG=                                                                   # Set to true only in local development; defaults to false.
# DJANGO_ALLOWED_HOSTS=                                                    # Comma-separated hostnames for Django; local dev and Render hostnames go here.
# RENDER_EXTERNAL_HOSTNAME=                                                 # Render hostname added automatically to ALLOWED_HOSTS when present.
# CORS_ALLOWED_ORIGINS=                                                    # Comma-separated frontend origins allowed by CORS.
# CSRF_TRUSTED_ORIGINS=                                                    # Comma-separated origins trusted for CSRF; may be blank.
# DATABASE_URL=                                                             # Postgres connection URL for Render; if set, it overrides the local DB_* values.
# DB_NAME=                                                                 # Local PostgreSQL database name.
# DB_USER=                                                                 # Local PostgreSQL username.
# DB_PASSWORD=                                                             # Local PostgreSQL password.
# DB_HOST=                                                                 # Local PostgreSQL host.
# DB_PORT=                                                                 # Local PostgreSQL port.
# PAYSTACK_SECRET_KEY=                                                     # Paystack secret key used for API requests and verification.
# PAYSTACK_BASE_URL=                                                       # Paystack API base URL; defaults to https://api.paystack.co.

